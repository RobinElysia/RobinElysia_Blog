# 环境变量模板 —— 复制为 .env.local 并填入真实值
# 完整说明见 .claude/architecture/runtime-and-deployment.md

# 数据库（必需，PostGre 连接串）
# 本地示例：postgresql://postgres:postgres@localhost:5432/blog
DATABASE_URL=postgresql://localhost:5432/blog

# 站点绝对 URL（RSS/Sitemap 的 link 前缀，生产必填）
SITE_URL=http://localhost:3000

# Dashboard 鉴权（NextAuth v5）
# 生产：GitHub OAuth App 的凭据
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# GitHub 登录白名单（逗号分隔用户名/邮箱；留空=拒绝所有 GitHub 登录，安全默认）
# AUTH_GITHUB_ALLOWED_USERS=meowin
# 本地开发：Credentials 登录（管理员单用户）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 生产必填（openssl rand -base64 32 生成）
AUTH_SECRET=
# 本地非默认端口/反向代理的 Host 信任（E2E 3011 等）；生产 Vercel 自动信任，可省略
AUTH_TRUST_HOST=true

# CMS/CI webhook revalidation 共享密钥（接入时启用）
# REVALIDATION_SECRET=

# ============================================
# Docker Compose 生产部署（PROD_* 前缀：compose 插值专用，防 shell 残留覆盖）
# 完整指南见 DEPLOY.md；复制到 .env 后填写真实值
# ============================================
# 站点绝对 URL（生产域名，https）
PROD_SITE_URL=https://blog.example.com

# 域名（Caddy 自动 HTTPS 的证书域名；DNS 需先指向服务器）
# 本地测试留空 = localhost（Caddy 自签证书）
PROD_DOMAIN=blog.example.com

# NextAuth 密钥（openssl rand -base64 32 生成）
PROD_AUTH_SECRET=

# 后台登录（Credentials provider）
PROD_ADMIN_USERNAME=admin
PROD_ADMIN_PASSWORD=

# 数据库（compose 内置 postgres；PROD_DATABASE_URL 的主机名必须是 db）
PROD_POSTGRES_USER=postgres
PROD_POSTGRES_PASSWORD=
PROD_POSTGRES_DB=blog
PROD_DATABASE_URL=postgresql://postgres:密码@db:5432/blog

# GitHub OAuth（可选，用于 GitHub 登录）
PROD_AUTH_GITHUB_ID=
PROD_AUTH_GITHUB_SECRET=
PROD_AUTH_GITHUB_ALLOWED_USERS=

# 端口覆盖（可选；本地测试避开 80/443 冲突用，生产留空用默认）
# PROD_HTTP_PORT=3080
# PROD_HTTPS_PORT=3443
